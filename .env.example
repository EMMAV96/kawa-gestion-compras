# EXAMPLE ONLY. Do not commit .env. Variables must be exported or set on Render.
# Django does not read this file automatically.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=
# Comma-separated hostnames only. Render adds RENDER_EXTERNAL_HOSTNAME automatically.
DJANGO_ALLOWED_HOSTS=kawa-example.onrender.com
DJANGO_CSRF_ORIGINS=https://kawa-example.onrender.com
# Placeholder: replace only in your environment/Render secret settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
KAWA_PUBLIC_DEMO=false
# Optional public demo: six UNIQUE generated passwords, only after authorization.
# JSON keys: demo_admin, demo_compras, demo_finanzas, demo_ventas_rosario,
# demo_ventas_mendoza, demo_ventas_cordoba. Never use local demo passwords.
KAWA_DEMO_PASSWORDS=

# Local demo initialization only; no default password, never used in public mode.
KAWA_LOCAL_DEMO_PASSWORD=
